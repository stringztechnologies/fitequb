{
	"name": "fitequb",
	"private": true,
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "pnpm --filter @fitequb/shared build && pnpm --filter @fitequb/api typecheck && pnpm --filter @fitequb/bot typecheck && pnpm --filter @fitequb/web typecheck",
		"test": "vitest",
		"test:db": "node scripts/test-pilot-db.mjs",
		"test:pilot-browser": "playwright test --config playwright.pilot.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@playwright/test": "^1.58.2",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@9.15.9"
}
